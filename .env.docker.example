# ============================================
# Vanguard — Environment Variables
# Copy this file to .env and customize values
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vanguard_db
DATABASE_URL=postgresql://postgres:password@postgres:5432/vanguard_db

# --- InfluxDB ---
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=vanguard-org
INFLUX_BUCKET=vanguard_telemetry
INFLUX_TOKEN=vanguard-influx-token-2024

# --- MQTT ---
BROKER_URL=mqtt://mosquitto:1883
NEXT_PUBLIC_MQTT_BROKER_URL=ws://localhost:9001/mqtt

# --- Authentication ---
BETTER_AUTH_SECRET=vanguard-auth-secret-change-me-in-production-min-32
BETTER_AUTH_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
