# --- Build Outputs ---
dist/
build/
.turbo/
*.tsbuildinfo

# --- Dependencies ---
# Usually handled by the root .gitignore, but good to have as a safety net
node_modules/

# --- Environment Variables ---
# Never commit secrets!
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# --- Debug/Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log

# --- Runtime Metadata ---
.hono/
.next/
.cache/

# --- Testing ---
coverage/
.nyc_output

# --- OS / IDE ---
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?